# Copy to .env and fill in, then export it before `python -m builder_bot_example` (see README.md):
#   set -a; . examples/builder_bot/.env; set +a
# Secrets never go here: they are files under secrets/ (openai_api_key, computer_token_secret).

# The local OpenAI-compatible endpoint and the model it serves (for example the lab box's server).
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_MODEL=
# Optional: false for an endpoint that cannot stream a tool call (a proxy that sends only keep-alives). Unset,
# calls stream, so what the bot writes reaches the screen as it writes it.
# OPENAI_STREAM=true

# The rootless Docker or Podman API socket the bench runs on. On macOS:
#   podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}'
# It can change across reboots, so there is no default.
BUILDER_SANDBOX_SOCKET=

# Optional: the one image the bench may use (docker/bench/Dockerfile builds it; nothing is pulled). It must be
# built for the checked-out commit (--build-arg MOSFET_COMMIT=$(git rev-parse HEAD)); a stale one is refused.
# BUILDER_SANDBOX_IMAGE=localhost/mosfet-bench:2
# Optional: the owner's egress bridge network. Unset, the bench has no network at all.
# BUILDER_SANDBOX_EGRESS_NETWORK=
# Optional: runc (the default) or runsc for gVisor.
# BUILDER_SANDBOX_RUNTIME=runc

# Optional: where the person's computer is served. Loopback by default; anything else is plaintext ws:// on that
# network (see README.md, Security).
# BUILDER_COMPUTER_HOST=127.0.0.1
# BUILDER_COMPUTER_PORT=8765
# BUILDER_COMPUTER_PEER=builder-desk

# Optional: who uses the computer, stamped on what it observes.
# BUILDER_PERSON_ID=
# Optional: the owner's traits for the bot, comma separated.
# BUILDER_TRAITS=careful,curious,candid

# Optional: full also records prompts and tool payloads (credentials redacted); unset, telemetry carries counts.
# BOT_OTEL_CAPTURE=full
