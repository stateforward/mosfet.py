# Copy to .env and fill in. compose.yaml reads .env into the minimal service's environment.

# The lab box on the LAN, and its OpenAI-compatible LLM endpoint: put the port that endpoint listens on in
# place of PORT.
LAB_HOST=192.168.2.32
OPENAI_BASE_URL=http://${LAB_HOST}:PORT/v1
# The model that endpoint serves.
OPENAI_MODEL=
# The decision server the bot's reflex decides on (a decision model, never a chat model): anygame's decide on
# the lab box, or any server that speaks the decisions wire format. decide takes no key; a hosted server's key goes
# in secrets/decision_api_key, which compose does not mount by default.
DECISION_BASE_URL=http://${LAB_HOST}:8102
# Optional: the decision model's context in tokens, which each decision request is fitted to (decide's is 2048).
DECISION_MAX_CONTEXT_TOKENS=2048

# Optional: export telemetry over OTLP; without it the JSONL files on the data volume are the record.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional: full also records prompts and tool payloads (credentials redacted); unset, telemetry carries counts.
# BOT_OTEL_CAPTURE=full
