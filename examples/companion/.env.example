# Copy to .env and fill in, then export it before `python -m companion_example` (see README.md):
#   set -a; . examples/companion/.env; set +a
# Secrets never go here: computer_token_secret is a file under secrets/ (or COMPUTER_TOKEN_SECRET_FILE).

# The lab model server: CT 108 "mosfet" on lab, 192.168.2.2 (a DHCP lease; see lab-ct108.md if it moves).
# Intuition answers without thinking first and reasoning thinks first; both run on Gemma for now.
COMPANION_INTUITION_URL=http://192.168.2.2:8100/v1
COMPANION_INTUITION_MODEL=gemma-4-26b-a4b
COMPANION_REASONING_URL=http://192.168.2.2:8100/v1
COMPANION_REASONING_MODEL=gemma-4-26b-a4b
# Optional: how many tokens reasoning may think for before it chooses what to do (Gemma's thinking channel,
# capped by vLLM's thinking_token_budget); 0 turns its thinking off. Intuition never thinks first.
COMPANION_THINKING_TOKENS=1024
# Optional, owner-configured: the language models' context in tokens. Set it to the chat server's own
# --max-model-len; each intuition and reasoning prompt is fitted to it by trimming only what the companion recalls,
# never the turn. The lab's server serves 32k.
COMPANION_MAX_CONTEXT_TOKENS=32768
COMPANION_EMBED_URL=http://192.168.2.2:8014/v1
COMPANION_EMBED_MODEL=embeddinggemma-2
COMPANION_STT_URL=ws://192.168.2.2:8001
COMPANION_TRANSCRIBE_URL=http://192.168.2.2:8001/v1
# Speech is the stack's Breeze engine: the companion designs one voice of its own there.
COMPANION_TTS_URL=http://192.168.2.2:8002
COMPANION_VOICEPRINT_URL=http://192.168.2.2:8003
COMPANION_EMOTION_URL=http://192.168.2.2:8004
COMPANION_DIAR_URL=http://192.168.2.2:8005
# The lab's servers take no key, but the client needs one: the openai_api_key secret, or this placeholder.
OPENAI_API_KEY=local
# The companion's reflex decides on a decision model, never a chat model: the stack's decide (pplx-decider-flash), which
# speaks the decisions wire format. decide takes no key, and the companion sends it none: a decision server's key is the
# optional decision_api_key secret, which never goes here.
DECISION_BASE_URL=http://192.168.2.2:8102
# decide's context is 2048 tokens: each decision request is fitted to it by cutting the turn's context, never its
# stimuli.
DECISION_MAX_CONTEXT_TOKENS=2048

# The rooms' computers' websocket server. Loopback by default; anything else is plaintext ws:// on that
# network (see README.md, Security).
COMPANION_HOST=0.0.0.0
COMPANION_PORT=8765
# Each room and what its computer sits on, as room:object, comma separated: kitchen:counter,den:shelf
COMPANION_ROOMS=living-room:shelf

# Optional: 1 to see through the rooms' cameras, with the OpenCV Zoo's YuNet and SFace in COMPANION_FACE_MODELS.
COMPANION_CAMERA=0
# COMPANION_FACE_MODELS=/path/to/opencv-models
# Optional: the owner's traits for the companion, comma separated.
# COMPANION_TRAITS=warm,patient,curious,honest
# COMPUTER_TOKEN_SECRET_FILE=./secrets/computer_token_secret

# Optional: full also records prompts and tool payloads (credentials redacted); unset, telemetry carries counts.
# BOT_OTEL_CAPTURE=full
