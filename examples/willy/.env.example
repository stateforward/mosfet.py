# Copy to .env and fill in, then export it before `python -m willy_example` (see README.md):
#   set -a; . examples/willy/.env; set +a
# Secrets never go here: computer_token_secret is a file under secrets/ (or COMPUTER_TOKEN_SECRET_FILE).

# The lab model server: CT 108 "mosfet" on lab, 192.168.2.2 (a DHCP lease; see lab-ct108.md if it moves).
WILLY_LLM_URL=http://192.168.2.2:8100/v1
WILLY_MODEL=gemma-4-26b-a4b
WILLY_EMBED_URL=http://192.168.2.2:8014/v1
WILLY_EMBED_MODEL=embeddinggemma-2
WILLY_STT_URL=ws://192.168.2.2:8001
WILLY_TRANSCRIBE_URL=http://192.168.2.2:8001/v1
# Speech is the stack's Breeze engine: Willy designs one voice of its own there.
WILLY_TTS_URL=http://192.168.2.2:8002
WILLY_VOICEPRINT_URL=http://192.168.2.2:8003
WILLY_EMOTION_URL=http://192.168.2.2:8004
WILLY_DIAR_URL=http://192.168.2.2:8005
# The lab's servers take no key, but the client needs one: the openai_api_key secret, or this placeholder.
OPENAI_API_KEY=local
# Willy's intuition decides on a decision model, never a chat model: the stack's decide (pplx-decider-flash), which
# speaks the decisions wire format. decide takes no key, and Willy sends it none: a decision server's key is the
# optional decision_api_key secret, which never goes here.
DECISION_BASE_URL=http://192.168.2.2:8102
# decide's context is 2048 tokens: each decision request is fitted to it by cutting the turn's context, never its
# stimuli.
DECISION_MAX_CONTEXT_TOKENS=2048

# The rooms' computers' websocket server. Loopback by default; anything else is plaintext ws:// on that
# network (see README.md, Security).
WILLY_HOST=0.0.0.0
WILLY_PORT=8765
# Each room and what its computer sits on, as room:object, comma separated: kitchen:counter,den:shelf
WILLY_ROOMS=living-room:shelf

# Optional: 1 to see through the rooms' cameras, with the OpenCV Zoo's YuNet and SFace in WILLY_FACE_MODELS.
WILLY_CAMERA=0
# WILLY_FACE_MODELS=/path/to/opencv-models
# Optional: the owner's traits for Willy, comma separated.
# WILLY_TRAITS=warm,patient,curious,honest
# COMPUTER_TOKEN_SECRET_FILE=./secrets/computer_token_secret

# Optional: full also records prompts and tool payloads (credentials redacted); unset, telemetry carries counts.
# BOT_OTEL_CAPTURE=full
