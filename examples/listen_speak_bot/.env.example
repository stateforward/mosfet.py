# The bot thinks with Gemini: one model (BOT_GEMINI_API_KEY, GEMINI_API_KEY or GOOGLE_API_KEY).
# BOT_GEMINI_API_KEY=
# BOT_GEMINI_MODEL=gemini-3.5-flash

# Its reflex decides on a decision model, never a chat model, on a server that speaks the decisions wire
# format: anygame's decide, which takes no key, or a hosted server with the same format and its DECISION_API_KEY.
# Each decision request is fitted to DECISION_MAX_CONTEXT_TOKENS, the decision model's context (decide's is 2048).
DECISION_BASE_URL=http://127.0.0.1:8102
DECISION_MAX_CONTEXT_TOKENS=2048
# DECISION_API_KEY=

# Optional MLX Audio model overrides. Provider defaults apply when unset.
# BOT_SILERO_VAD_MODEL=mlx-community/silero-vad
# BOT_STT_MODEL=mlx-community/whisper-large-v3-turbo-asr-fp16

# Optional local PyAnnote speaker-embedding model override. Provider runtime auth/model access
# is configured outside this example; no credential is stored here.
# BOT_PYANNOTE_VOICE_IDENTITY_MODEL=pyannote/wespeaker-voxceleb-resnet34-LM

# Optional lab wiring, each on its own: the streaming speech server hears, the voiceprint server
# knows voices apart, and the speech engine speaks in the voice the bot is born with.
# BOT_SPEECH_SERVER_STREAM_URL=ws://192.168.2.2:8001
# BOT_SPEECH_SERVER_URL=http://192.168.2.2:8003
# BOT_SPEECH_SERVER_TTS_URL=http://192.168.2.2:8002
