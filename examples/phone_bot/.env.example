# Copy to .env and fill secrets. For local LiveKit phone-bot you only need the LiveKit block.

# --- LiveKit (local SFU via docker compose: livekit-server --dev) ---
# WebSocket URL for the Python RTC client (ws, not http).
BOT_LIVEKIT_URL=ws://127.0.0.1:7880
# Dev key/secret from `livekit-server --dev` / docker-compose.
BOT_LIVEKIT_API_KEY=devkey
BOT_LIVEKIT_API_SECRET=secret
# Room + participant for auto-minted access tokens (used when BOT_LIVEKIT_TOKEN is unset).
BOT_LIVEKIT_ROOM=bot-phone-bot
BOT_LIVEKIT_IDENTITY=bot-phone-bot
BOT_LIVEKIT_TRACK_NAME=bot-phone-bot
# Optional: paste a pre-minted JWT instead of api_key/secret minting.
# BOT_LIVEKIT_TOKEN=

# --- What this bot was told ---
# One instruction, in the words you would say it in. It is recalled as a standing directive from
# the bot's first turn onward; whether to act on it is the bot's decision, not this file's.
# Repeat the flag `--tell` on the command line to tell it more than one thing.
# A number here is a LiveKit participant identity — the same string `mint-livekit-token
# --identity` is given, which is what the bot would dial.
# BOT_TELL=Call phone-bot-bob.

# --- Cognition (required for full can_talk) ---
# Intuition: Mercury 2 (OpenAI-compatible / Inception)
# BOT_MERCURY_API_KEY=
# BOT_MERCURY_BASE_URL=https://api.inceptionlabs.ai/v1
# BOT_MERCURY_MODEL=mercury-2
# Reasoning + reflection: OpenAI Terra
# BOT_OPENAI_API_KEY=
# BOT_OPENAI_BASE_URL=https://api.openai.com/v1
# BOT_REASONING_MODEL=gpt-5.6-terra
# BOT_REFLECTION_MODEL=gpt-5.6-terra

# --- Speech (Silero VAD local + off-device Gemini STT/TTS; required for can_talk) ---
# BOT_GEMINI_API_KEY=
# STT
# BOT_GEMINI_STT_MODEL=gemini-3.5-flash
# TTS
# BOT_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# BOT_GEMINI_TTS_VOICE=Kore
# VAD: local Silero via mlx-audio (cheap; not peak-energy)
# BOT_SILERO_VAD_MODEL=mlx-community/silero-vad
