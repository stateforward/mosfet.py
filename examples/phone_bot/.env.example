# Copy to .env, fill the two keys, and load it: set -a; . ./.env; set +a

# --- OpenTelemetry (opt-out local JSONL export of text-generator requests) ---
# Default: enabled for development. Writes raw generator prompts/tools to disk (mode 0600).
# Set to 1/true/yes/on to disable when prompts must not be persisted locally.
# BOT_OTEL_DISABLED=1
# JSONL path (default: otel-logs.jsonl). Must resolve under the process working directory.
# BOT_OTEL_LOG_FILE=otel-logs.jsonl

# --- LiveKit (local SFU via docker compose: livekit-server --dev) ---
# WebSocket URL for the Python RTC client (ws, not http).
BOT_LIVEKIT_URL=ws://127.0.0.1:7880
# Dev key/secret from `livekit-server --dev` / docker-compose.
BOT_LIVEKIT_API_KEY=devkey
BOT_LIVEKIT_API_SECRET=secret
# Room + participant for auto-minted access tokens (used when BOT_LIVEKIT_TOKEN is unset).
BOT_LIVEKIT_ROOM=bot-phone-bot
# Participant identity is this line's phone number — same normalized digit form dialing uses
# (separators stripped: 555-0141 → 5550141). Token mint and dial destination must match.
BOT_LIVEKIT_IDENTITY=5550141
BOT_LIVEKIT_TRACK_NAME=5550141
# Optional: paste a pre-minted JWT instead of api_key/secret minting.
# BOT_LIVEKIT_TOKEN=
# Optional alias remaps only (`number=identity`, comma separated). Empty/unset is normal:
# dialing addresses setup at the dialled number as participant identity. Use only when a number
# must map to a different identity. Fictional 555-0100..555-0199 range.
# BOT_LIVEKIT_DIAL_PLAN=5550142=alias-bob

# There is nothing here for saying something to the bot. Talking to it is not configuration:
# run `uv run python -m phone_bot_example`, then type a line and press enter to say it out loud in its room.

# --- Cognition (required): one model, OpenAI's reasoning model ---
# BOT_OPENAI_API_KEY=
# BOT_OPENAI_BASE_URL=https://api.openai.com/v1
# BOT_REASONING_MODEL=gpt-5.6-terra
# Intuition (required): a decision model, never a chat model. Hosted TypeSafe with its key, or the local
# system_one server TYPESAFE_BASE_URL names, which takes none and is never sent TYPESAFE_API_KEY.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=http://127.0.0.1:8102

# --- Speech (required): Silero VAD + pyannote identity local, off-device Gemini STT/TTS ---
# BOT_GEMINI_API_KEY=
# STT
# BOT_GEMINI_STT_MODEL=gemini-3.5-flash
# TTS
# BOT_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# BOT_GEMINI_TTS_VOICE=Kore
# VAD: local Silero via mlx-audio (cheap; not peak-energy)
# BOT_SILERO_VAD_MODEL=mlx-community/silero-vad
# Voice identity: local pyannote speaker embeddings so Listening speech carries source_ids
# BOT_PYANNOTE_VOICE_IDENTITY_MODEL=pyannote/wespeaker-voxceleb-resnet34-LM

# --- Logs: DEBUG with 1 (every machine's observer), INFO otherwise ---
# BOT_VERBOSE=0
